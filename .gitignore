# 执行 Agent 的产出默认不入库；已跟踪的起始代码不受影响
tasks/*/workspace/*
!tasks/*/workspace/.gitkeep

# 任务素材默认不入库（体积或版权原因）；目录结构由 .gitkeep 保留
tasks/*/assets/*
tasks/*/reference/*
!tasks/*/assets/.gitkeep
!tasks/*/reference/.gitkeep

